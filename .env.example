# Keepa API キー（必須）
KEEPA_API_KEY=xxxxxxxx-keepa-key

# 監視対象の商品設定（JSON 配列）
# 例: [
#   {"asin": "B000000000", "cost_price": 1200, "min_profit": 300, "min_margin": 0.15, "min_sale_price": 1800, "title": "サンプル商品"}
# ]
PRODUCT_CATALOG=[{"asin":"B000000000","cost_price":1200,"min_profit":300,"min_margin":0.15,"min_sale_price":1800,"title":"サンプル商品"}]

# Slack 等の受信 Webhook URL（必須）
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX

# 利益計算パラメータ
PROFIT_FEE_RATE=0.15
PROFIT_FBA_FEE=440

# 通信/リトライ設定
REQUEST_TIMEOUT=15
RETRY_COUNT=3
RETRY_BACKOFF_SECONDS=1
WEBHOOK_RETRIES=3
RATE_LIMIT_INTERVAL=1.0

# Keepa ドメイン (5=Amazon.co.jp)
KEEPA_DOMAIN=5

# 実行挙動
LOG_LEVEL=INFO
DRY_RUN=false
